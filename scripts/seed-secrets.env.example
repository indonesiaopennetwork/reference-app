# Copy to scripts/seed-secrets.env and fill in your real values, then run:
#   task deploy:seed-secrets PROJECT_ID=<your-project-id>
# (or: PROJECT_ID=<your-project-id> ./scripts/seed-secrets.sh scripts/seed-secrets.env)
#
# scripts/seed-secrets.env is gitignored — never commit it with real values.
#
# BAP_PRIVATE_KEY/BAP_KEY_ID must be the SAME registered keypair/identity as
# BAP_ONIX_SIGNING_PRIVATE_KEY/BAP_ONIX_KEY_ID (same rule for bpp) — see the
# comment in scripts/seed-secrets.sh and README.md's Prerequisites section.

BAP_PRIVATE_KEY=
BAP_KEY_ID=REPLACE_WITH_YOUR_SUBSCRIBER_ID|REPLACE_WITH_YOUR_KEY_ID|ed25519
BPP_PRIVATE_KEY=
BPP_KEY_ID=REPLACE_WITH_YOUR_SUBSCRIBER_ID|REPLACE_WITH_YOUR_KEY_ID|ed25519

BAP_ONIX_KEY_ID=REPLACE_WITH_YOUR_DEDI_RECORD_ID_OR_RECORD_NAME
BAP_ONIX_SIGNING_PRIVATE_KEY=
BAP_ONIX_SIGNING_PUBLIC_KEY=
BAP_ONIX_ENCR_PRIVATE_KEY=
BAP_ONIX_ENCR_PUBLIC_KEY=

BPP_ONIX_KEY_ID=REPLACE_WITH_YOUR_DEDI_RECORD_ID_OR_RECORD_NAME
BPP_ONIX_SIGNING_PRIVATE_KEY=
BPP_ONIX_SIGNING_PUBLIC_KEY=
BPP_ONIX_ENCR_PRIVATE_KEY=
BPP_ONIX_ENCR_PUBLIC_KEY=

# discovery-service's own outbound on_discover signing identity. For the
# default setup (borrowing bap's own onix-bap identity — see
# terraform/variables.tf's discovery_service_subscriber_id/uri), just
# copy the same values as BAP_ONIX_KEY_ID/BAP_ONIX_SIGNING_PRIVATE_KEY
# above. Once discovery-service has its own real, independently
# registered network identity, these become genuinely different values
# instead — no other file needs to change at that point.
DISCOVERY_SERVICE_SUBSCRIBER_KEY_ID=
DISCOVERY_SERVICE_SIGNING_PRIVATE_KEY=

# DOKU Checkout (https://developers.doku.com/accept-payments/doku-checkout)
# sandbox credentials, from the DOKU Back Office (dashboard.doku.com) --
# used only by bap-application, to create a hosted payment session and
# verify DOKU's payment notification.
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
