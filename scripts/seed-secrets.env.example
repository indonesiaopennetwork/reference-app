# Copy to scripts/seed-secrets.env and fill in your real values, then run:
#   task deploy:seed-secrets PROJECT_ID=<your-project-id>
# (or: PROJECT_ID=<your-project-id> ./scripts/seed-secrets.sh scripts/seed-secrets.env)
#
# scripts/seed-secrets.env is gitignored — never commit it with real values.
#
# BAP_PRIVATE_KEY/BAP_KEY_ID must be the SAME registered keypair/identity as
# BAP_ONIX_SIGNING_PRIVATE_KEY/BAP_ONIX_KEY_ID (same rule for bpp) — see the
# comment in scripts/seed-secrets.sh and README.md's Prerequisites section.

BAP_PRIVATE_KEY=
BAP_KEY_ID=REPLACE_WITH_YOUR_SUBSCRIBER_ID|REPLACE_WITH_YOUR_KEY_ID|ed25519
BPP_PRIVATE_KEY=
BPP_KEY_ID=REPLACE_WITH_YOUR_SUBSCRIBER_ID|REPLACE_WITH_YOUR_KEY_ID|ed25519

BAP_ONIX_KEY_ID=
BAP_ONIX_SIGNING_PRIVATE_KEY=
BAP_ONIX_SIGNING_PUBLIC_KEY=
BAP_ONIX_ENCR_PRIVATE_KEY=
BAP_ONIX_ENCR_PUBLIC_KEY=

BPP_ONIX_KEY_ID=
BPP_ONIX_SIGNING_PRIVATE_KEY=
BPP_ONIX_SIGNING_PUBLIC_KEY=
BPP_ONIX_ENCR_PRIVATE_KEY=
BPP_ONIX_ENCR_PUBLIC_KEY=
