routingRules:
  - version: "2.0.0"
    targetType: "bpp"
    endpoints:
      - select
      - init
      - confirm
      - status
      - cancel
      - update
      - rate
      - support
  - version: "2.0.0"
    targetType: "url"
    target:
      url: "${DISCOVERY_SERVICE_URL}"
    endpoints:
      - discover
