# Local secrets — never commit
.env
bap-application/cmd/server/.env
bpp-application/cmd/server/.env
dedi-onboarding-files/.env.local
scripts/seed-secrets.env
# Personal VS Code debug config; copy .vscode/launch.json.example
.vscode/launch.json
# onix configs rendered from config/*.yaml.example by
# scripts/render-onix-config.sh (task local:up); they hold real keys
config/local-simple-bap.yaml
config/local-simple-bpp.yaml
config/catalog-publish.yaml
.zitadel-machinekey/

# Terraform local state/cache/vars — state lives in GCS, not here.
# .terraform.lock.hcl IS committed (pins exact provider versions).
terraform/.terraform/
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
# terraform.tfvars is shared through the state bucket instead (task tfvars:pull
# / tfvars:push); the generation file and .bak copies are those tasks' own.
terraform/terraform.tfvars
terraform/terraform.tfvars.bak.*
terraform/.terraform.tfvars.generation
terraform/*.tfplan

# Node
node_modules/
dist/
.DS_Store
file-onboarding-and-catalog-publish/
.problems/
.gitignore
