# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored — never commit real values there.

# --- Required, no default in variables.tf — terraform plan fails without these ---

# Your registered BAP subscriber ID. Must match onix-bap's own keyManager
# networkParticipant — see the comment on this variable in variables.tf.
bap_id = "onix-bap-xxxxxxxxxx-xx.a.run.app"

# Your registered BPP subscriber ID. Must match onix-bpp's own keyManager
# networkParticipant.
bpp_id = "sample-pn.your-domain.example"

# The Beckn network you're registered on.
network_id = "ion.id/ion-launch"

# discover_method is optional (default "GET") -- uncomment to override.
# "GET" calls the discovery-service this module deploys directly;
# "POST" routes discover through onix-bap as a real async Beckn action
# (needs discovery-service to have a real registered network identity first).
# discover_method = "GET"

# cds_discover_url is optional -- leave unset to use the discovery-service
# this module deploys. Set it to point at a different, externally-hosted
# discovery service instead.
# cds_discover_url = "https://your-discovery-service.example/discover"

# discovery_service_subscriber_id/uri are optional -- leave unset and
# discovery-service borrows bap's own onix-bap identity to sign its
# on_discover callbacks (works because that identity is already
# registered). Set both once discovery-service has its own real,
# independently-registered network identity (also reseed the
# discovery-service-subscriber-key-id/discovery-service-signing-private-key
# secrets to match -- see scripts/seed-secrets.env.example).
# discovery_service_subscriber_id  = "your-discovery-service-subscriber-id"
# discovery_service_subscriber_uri = "https://your-discovery-service-subscriber-uri"

# Custom domains — also required, no default on purpose (same reasoning as
# above: a hardcoded default is exactly how you'd end up deploying against a
# domain you don't control). Each must be a VERIFIED domain in Search Console
# under the same account/org that owns this GCP project before
# `terraform apply` succeeds on its google_cloud_run_domain_mapping resource
# — see README.md "Custom domain for DeDi discovery files" and the section
# right after it.
#
# bap_frontend_domain/bpp_frontend_domain are also injected as the
# BPP_ADMIN_URL/BAP_URL container env vars powering the cross-navigation
# buttons in the sibling frontend's UI — see README.md "Custom domains for
# bap, bap-frontend, bpp-frontend, and the landing page".
bpp_domain              = "your-domain.example"
bpp_domain_www          = "www.your-domain.example"
bap_domain              = "bap.your-domain.example"
bap_frontend_domain     = "shop.your-domain.example"
bpp_frontend_domain     = "seller.your-domain.example"
landing_page_domain     = "home.your-domain.example"
ion_landing_page_domain = "demo.your-domain.example"
zitadel_domain          = "auth.your-domain.example"

# Zitadel admin account, created on first boot (see cloud-run-zitadel.tf).
# Masterkey/admin password are self-generated by Terraform, not set here.
zitadel_admin_username = "admin"
zitadel_admin_email    = "you@your-domain.example"

# --- Commonly overridden (all have defaults in variables.tf) ---

project_id = "your-gcp-project-id"
region     = "asia-southeast1"

# Only needed if the default subnet_cidr (10.10.0.0/24) collides with
# something already in your VPC — see variables.tf for the constraint.
# subnet_cidr = "10.30.0.0/24"

# zitadel_client_id defaults to a placeholder so the first `terraform apply`
# succeeds even before Zitadel exists. After it's up, run
# scripts/setup-zitadel-cloud.sh and set the real value it prints here, then
# apply again — same two-phase pattern as the DB migration steps in README.md.
# zitadel_client_id = "..."

# --- Settlement and reconciliation (defaults in variables.tf) ---
# Payout accounts: set your real ones -- the defaults are demo accounts.
# bap_settlement_bank_code      = "MANDIRI"
# bap_settlement_account_number = "1370000000001"
# bap_settlement_account_name   = "Your BAP Pte Ltd"
# bpp_settlement_bank_code      = "BCA"
# bpp_settlement_account_number = "8730000000001"
# bpp_settlement_account_name   = "Your BPP Pte Ltd"
#
# settlement_basis                     = "AFTER_DELIVERY" # or AFTER_SHIPMENT, ON_CONFIRMATION, AFTER_RETURN_WINDOW
# settlement_window                    = "PT2M"           # testing; P1D for production
# reconcile_wait_for_settlement_window = false            # testing; true for production
# commission_type                      = "PERCENT"        # or AMOUNT (per unit)
# commission_value                     = 3
# commission_applies_to                = "ITEM_TOTAL"     # or ORDER_TOTAL
