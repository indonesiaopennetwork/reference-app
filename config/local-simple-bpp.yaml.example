# Rendered into config/local-simple-bpp.yaml by scripts/render-onix-config.sh,
# which substitutes the ${...} placeholders below from the repo root .env.
# Don't hand-edit the generated file's keyManager values -- edit .env and
# re-run the script instead.
appName: "onix-local"
log:
  level: debug
  destinations:
    - type: stdout
  contextKeys:
    - transaction_id
    - message_id
    - subscriber_id
    - module_id
http:
  port: 8082
  timeout:
    read: 30
    write: 30
    idle: 30
pluginManager:
  root: ./plugins

# Ships telemetry to the otel-collector-bpp sidecar (docker-compose.yml),
# which filters and forwards only network-relevant signals to
# netcol.iontest.in — see otel-collector/config.yaml. `producer` must be the
# SAME value as `networkParticipant` in the keyManager blocks below (one
# registered identity) — when you replace that stale example value with your
# real subscriber ID, update this to match too, or telemetry will be
# attributed to the wrong participant.
plugins:
  otelsetup:
    id: otelsetup
    config:
      serviceName: "beckn-onix"
      otlpEndpoint: "otel-collector-bpp:4317"
      enableMetrics: "true"
      enableTracing: "true"
      enableLogs: "true"
      timeInterval: "5"
      auditFieldsConfig: "/app/config/audit-fields.yaml"
      producer: "bpptest1.remiges.tech"
      producerType: "bpp"

modules:
  - name: bppTxnReceiver
    path: /bpp/receiver/
    handler:
      type: std
      role: bpp
      httpClientConfig:
        maxIdleConns: 1000
        maxIdleConnsPerHost: 200
        idleConnTimeout: 300s
        responseHeaderTimeout: 30s
      plugins:
        registry:
          id: dediregistry
          config:
            url: https://fabric.nfh.global/registry/dedi
            timeout: 10
            retry_max: 3
            retry_wait_min: 100ms
            retry_wait_max: 500ms
        keyManager:
          id: simplekeymanager
          config:
            networkParticipant: ${BPP_NETWORK_PARTICIPANT}
            keyId: ${BPP_ONIX_KEY_ID}
            signingPrivateKey: ${BPP_ONIX_SIGNING_PRIVATE_KEY}
            signingPublicKey: ${BPP_ONIX_SIGNING_PUBLIC_KEY}
            encrPrivateKey: ${BPP_ONIX_ENCR_PRIVATE_KEY}
            encrPublicKey: ${BPP_ONIX_ENCR_PUBLIC_KEY}
        schemaValidator:
          id: schemav2validator
          config:
            type: url
            location: https://schema.ion.id/release1/schema/vendored/beckn/protocol/v2.0.0/beckn.yaml
            cacheTTL: "3600"
            # Extended Schema validation resolves every ion:IONTrade* @context object in
            # a payload against schema.ion.id at runtime. An on_discover carrying a
            # 4-item catalog has 12 such objects, whose transitive $ref closure is 19
            # distinct documents / ~444 $ref occurrences (TradeResource alone has 23,
            # reaching RetailResource 2.1, Quantity 2.0, AcceptedPaymentMethod, ...).
            #
            # downloadTimeout 90: a COLD resolve of that closure measured ~22s against
            # a healthy schema.ion.id. The previous 30 left almost no margin and failed
            # intermittently with "context deadline exceeded" / "TLS handshake timeout"
            # -- which reads like a schema-shape error in the logs but is a fetch
            # timeout. A failed download is never cached, so it then re-fails forever.
            #
            # maxCacheSize 1000: must exceed the closure size. onix's errors cite
            # property-level pointers (.../Quantity/2.0/attributes.yaml#/.../unitText),
            # so entries can be keyed per $ref rather than per document -- the old 100
            # is below the ~444 occurrence count and risks thrashing a cache that then
            # never warms.
            #
            # Once warm (cacheTTL 86400 = 24h) the same validation is sub-second, so
            # these budgets are only ever spent once per adapter restart.
            extendedSchema_enabled: "true"
            extendedSchema_cacheTTL: "86400"
            extendedSchema_maxCacheSize: "1000"
            extendedSchema_downloadTimeout: "90"
            extendedSchema_allowedDomains: "raw.githubusercontent.com,schema.ion.id,schema.beckn.io"
            # Beckn extension specs merged into the action index (/reconcile,
            # /on_reconcile) -- see docs/specs/reconcile.yaml.
            auxiliaryTypes: "file"
            auxiliaryLocations: "/app/specs/reconcile.yaml"
        cache:
          id: cache
          config:
            addr: redis-bpp:6379
        signValidator:
          id: signvalidator
        signer:
          id: signer
        router:
          id: router
          config:
            routingConfig: ./config/local-simple-routing-BPPReceiver.yaml
        payloadStore:
          id: payloadstore
          config:
            ttl: "24h"
            indexTTL: "25h"
            storeSignature: "true"
        middleware:
          - id: reqpreprocessor
            config:
              contextKeys: transactionId,messageId
              role: bpp
      steps:
        - validateSign
        - addRoute
        - validateSchema
        - signAck
  
  - name: bppTxnCaller
    path: /bpp/caller/
    handler:
      type: std
      role: bpp
      httpClientConfig:
        maxIdleConns: 1000
        maxIdleConnsPerHost: 200
        idleConnTimeout: 300s
        responseHeaderTimeout: 30s
      plugins:
        registry:
          id: dediregistry
          config:
            url: https://fabric.nfh.global/registry/dedi
            timeout: 10
            retry_max: 3
            retry_wait_min: 100ms
            retry_wait_max: 500ms
        keyManager:
          id: simplekeymanager
          config:
            networkParticipant: ${BPP_NETWORK_PARTICIPANT}
            keyId: ${BPP_ONIX_KEY_ID}
            signingPrivateKey: ${BPP_ONIX_SIGNING_PRIVATE_KEY}
            signingPublicKey: ${BPP_ONIX_SIGNING_PUBLIC_KEY}
            encrPrivateKey: ${BPP_ONIX_ENCR_PRIVATE_KEY}
            encrPublicKey: ${BPP_ONIX_ENCR_PUBLIC_KEY}
        schemaValidator:
          id: schemav2validator
          config:
            type: url
            location: https://schema.ion.id/release1/schema/vendored/beckn/protocol/v2.0.0/beckn.yaml
            cacheTTL: "3600"
            # Extended Schema validation resolves every ion:IONTrade* @context object in
            # a payload against schema.ion.id at runtime. An on_discover carrying a
            # 4-item catalog has 12 such objects, whose transitive $ref closure is 19
            # distinct documents / ~444 $ref occurrences (TradeResource alone has 23,
            # reaching RetailResource 2.1, Quantity 2.0, AcceptedPaymentMethod, ...).
            #
            # downloadTimeout 90: a COLD resolve of that closure measured ~22s against
            # a healthy schema.ion.id. The previous 30 left almost no margin and failed
            # intermittently with "context deadline exceeded" / "TLS handshake timeout"
            # -- which reads like a schema-shape error in the logs but is a fetch
            # timeout. A failed download is never cached, so it then re-fails forever.
            #
            # maxCacheSize 1000: must exceed the closure size. onix's errors cite
            # property-level pointers (.../Quantity/2.0/attributes.yaml#/.../unitText),
            # so entries can be keyed per $ref rather than per document -- the old 100
            # is below the ~444 occurrence count and risks thrashing a cache that then
            # never warms.
            #
            # Once warm (cacheTTL 86400 = 24h) the same validation is sub-second, so
            # these budgets are only ever spent once per adapter restart.
            extendedSchema_enabled: "true"
            extendedSchema_cacheTTL: "86400"
            extendedSchema_maxCacheSize: "1000"
            extendedSchema_downloadTimeout: "90"
            extendedSchema_allowedDomains: "raw.githubusercontent.com,schema.ion.id,schema.beckn.io"
            # Beckn extension specs merged into the action index (/reconcile,
            # /on_reconcile) -- see docs/specs/reconcile.yaml.
            auxiliaryTypes: "file"
            auxiliaryLocations: "/app/specs/reconcile.yaml"
        cache:
          id: cache
          config:
            addr: redis-bpp:6379
        router:
          id: router
          config:
            routingConfig: ./config/local-simple-routing-BPPCaller.yaml
        signer:
          id: signer
        signValidator:
          id: signvalidator
        payloadStore:
          id: payloadstore
          config:
            ttl: "24h"
            indexTTL: "25h"
            storeSignature: "true"
        middleware:
          - id: reqpreprocessor
            config:
              contextKeys: transactionId,messageId
              role: bpp
      steps:
        - addRoute
        - sign
        - storePayload
        - validateSchema
        - validateAckSign
