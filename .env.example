# Copy to .env and fill in your own registered signing keys.
#
# This file is the single source for every keyManager field in
# config/local-simple-bap.yaml, config/local-simple-bpp.yaml, and
# config/catalog-publish.yaml — run ./scripts/render-onix-config.sh after
# filling this in to generate them from their .example templates (see
# INFRA_SETUP.md 1b for exactly which field comes from where).
#
# Organized below by which service(s) actually consume each variable — see
# each section's own "consumed by" line. Several identity vars are
# legitimately read by more than one service (e.g. BAP_KEY_ID is bap-
# application's own signing key AND the identity discovery-service trusts
# as its caller) — those are called out explicitly rather than duplicated.

# =============================================================================
# NETWORK IDENTITY — consumed by: bap-application, bpp-application
# =============================================================================
NETWORK_ID=REPLACE_WITH_YOUR_NETWORK_ID

# =============================================================================
# BAP IDENTITY — consumed by: bap-application (direct, signs its own
# requests), onix-bap (the BAP_ONIX_* fields below, rendered into
# config/local-simple-bap.yaml by ./scripts/render-onix-config.sh),
# bpp-application (BAP_ID only, stamped as context.bapId on its own
# outbound messages), discovery-service (BAP_KEY_ID/BAP_ONIX_SIGNING_PUBLIC_KEY
# only, trusted as its caller's public identity — see the DISCOVERY SERVICE
# section below).
#
# BAP_PRIVATE_KEY/BAP_KEY_ID are read directly by the Go apps and must stay
# in their combined "subscriberId|keyId|ed25519" / plain-key-string shapes.
# The BAP_ONIX_* fields are only consumed by the onix yaml config, never by
# the Go apps, and must hold the SAME registered keypair as their
# *_PRIVATE_KEY/*_KEY_ID counterpart: BAP_ONIX_KEY_ID = the keyId segment of
# BAP_KEY_ID (the part between the two "|"s), BAP_ONIX_SIGNING_PRIVATE_KEY =
# BAP_PRIVATE_KEY verbatim. They're separate fields only because the Go app
# and the onix yaml consume the identity in different shapes — same rule
# for BPP below. (See terraform/README.md's Gotcha #1 for the full "why.")
# BAP_ID must equal the subscriber-ID segment of BAP_KEY_ID (the part
# before the first "|") — same one-identity-per-side rule.
# =============================================================================
BAP_PRIVATE_KEY=REPLACE_WITH_YOUR_SIGNING_PRIVATE_KEY
BAP_KEY_ID=REPLACE_WITH_YOUR_SUBSCRIBER_ID|REPLACE_WITH_YOUR_KEY_ID|ed25519
BAP_ID=REPLACE_WITH_YOUR_BAP_SUBSCRIBER_ID
BAP_ONIX_KEY_ID=REPLACE_WITH_YOUR_BAP_KEY_ID
BAP_ONIX_SIGNING_PRIVATE_KEY=REPLACE_WITH_YOUR_BAP_SIGNING_PRIVATE_KEY
BAP_ONIX_SIGNING_PUBLIC_KEY=REPLACE_WITH_YOUR_BAP_SIGNING_PUBLIC_KEY
BAP_ONIX_ENCR_PRIVATE_KEY=REPLACE_WITH_YOUR_BAP_ENCR_PRIVATE_KEY
BAP_ONIX_ENCR_PUBLIC_KEY=REPLACE_WITH_YOUR_BAP_ENCR_PUBLIC_KEY

# =============================================================================
# BPP IDENTITY — consumed by: bpp-application (direct), onix-bpp (the
# BPP_ONIX_* fields, rendered the same way as BAP's above), bap-application
# (BPP_ID only, stamped as context.bppId on its own outbound messages).
# Same shape/consistency rules as the BAP block above.
# =============================================================================
BPP_PRIVATE_KEY=REPLACE_WITH_YOUR_SIGNING_PRIVATE_KEY
BPP_KEY_ID=REPLACE_WITH_YOUR_SUBSCRIBER_ID|REPLACE_WITH_YOUR_KEY_ID|ed25519
BPP_ID=REPLACE_WITH_YOUR_BPP_SUBSCRIBER_ID
BPP_ONIX_KEY_ID=REPLACE_WITH_YOUR_BPP_KEY_ID
BPP_ONIX_SIGNING_PRIVATE_KEY=REPLACE_WITH_YOUR_BPP_SIGNING_PRIVATE_KEY
BPP_ONIX_SIGNING_PUBLIC_KEY=REPLACE_WITH_YOUR_BPP_SIGNING_PUBLIC_KEY
BPP_ONIX_ENCR_PRIVATE_KEY=REPLACE_WITH_YOUR_BPP_ENCR_PRIVATE_KEY
BPP_ONIX_ENCR_PUBLIC_KEY=REPLACE_WITH_YOUR_BPP_ENCR_PUBLIC_KEY

# =============================================================================
# BAP-APPLICATION ↔ DISCOVERY SERVICE — consumed by: bap-application only
# =============================================================================
# Selects which discover implementation bap-application's GET
# /api/v1/discover actually runs -- exactly one at a time (see
# internal/config.Config.DiscoverMethod in bap-application): GET = direct
# to discovery-service (bypasses onix-bap; works today). POST = the real
# async Beckn contract via onix-bap, same as every other action (needs
# discovery-service's identity to be resolvable through onix-bap's network
# registry -- see discovery-service/CONTEXT.md D20/D21 -- and onix-bap's
# own Extended Schema validation to reach schema.ion.id; see
# docker-compose.yml's DISPATCH_DELIVERY_TIMEOUT_SECONDS comment for why
# the first call after an onix-bap restart can take longer).
DISCOVER_METHOD=GET

# Full URL of discovery-service's own /discover endpoint, called DIRECTLY
# by bap-application -- bypassing onix-bap entirely. Used only when
# DISCOVER_METHOD=GET.
CDS_DISCOVER_URL=http://discovery-service:8087/discover

# =============================================================================
# DISCOVERY SERVICE — consumed by: discovery-service only, except where
# noted. An INDEPENDENT network participant, deliberately never sharing
# BAP's or BPP's private keys (a Discovery Service in Beckn v2 is
# architecturally its own subscriber, not a facade for a specific BPP --
# and even if it were, handing it another participant's private key would
# let it sign messages AS that participant, not just describe its
# catalog).
# =============================================================================
# Provider Node catalog index URL(s) discovery-service crawls for real
# catalog data (comma-separated for more than one) — see
# discovery-service/CONTEXT.md D19. catalog-files (see docker-compose.yml)
# is an nginx static server over
# file-onboarding-and-catalog-publish/data/beckn/, the directory
# onix-catalog-publish actually writes real index/baseline/change files
# to whenever bpp-application publishes a catalog — this is that same
# directory's index file, reachable over HTTP for the crawler. Leave
# blank to serve the embedded demo catalog instead (see
# discovery-service/data/catalog.json).
CATALOG_INDEX_URLS=http://catalog-files/index/becknCatalogs.index.json

# This service's OWN registered Beckn subscriber identity — a dedicated
# Ed25519 keypair generated just for it (e.g. `openssl rand -base64 32`),
# distinct from BAP_ID/BPP_ID above. It signs its outbound on_discover
# callback with this keypair, never a copy of BAP_*/BPP_*. DS_URI is just
# this service's own operational URI (stamped onto responses). Leave
# DS_KEY_ID/DS_PRIVATE_KEY blank to run with a fresh EPHEMERAL key every
# restart instead (stops a receiver rejecting a *missing* signature, but
# nobody can verify it until a persistent key is generated here AND
# actually registered on whatever network registry the counterpart
# verifies against — see INFRA_SETUP.md's "ask whoever administers the
# network registry" process, the same one used to register BAP_ID/BPP_ID;
# this can't be done from inside this repo).
DS_ID=
DS_KEY_ID=
DS_PRIVATE_KEY=
DS_URI=REPLACE_WITH_YOUR_DISCOVERY_SERVICE_URI

# It verifies inbound /discover requests against a single trusted caller
# (in this deployment, our own BAP), but ONLY its public half — reused
# from the BAP IDENTITY section above, not duplicated here:
# TRUSTED_CALLER_KEY_ID maps from BAP_KEY_ID (a public identifier, safe to
# share) and TRUSTED_CALLER_PUBLIC_KEY_BASE64 maps from
# BAP_ONIX_SIGNING_PUBLIC_KEY (a public key, also safe to share) — never
# BAP_PRIVATE_KEY. This service only ever needs to verify as the trusted
# caller, never sign as it, so it must never be given a credential capable
# of doing that. (See docker-compose.yml's discovery-service block for the
# actual mapping — no separate vars needed here.)

# =============================================================================
# POSTGRES — consumed by: postgres, bap-application, bpp-application
# (one instance, separate databases per app)
# =============================================================================
DB_USER=postgres
DB_PASSWORD=postgres

# =============================================================================
# FRONTEND CROSS-NAVIGATION — consumed by: frontend (bap-frontend),
# bpp-frontend
# =============================================================================
VITE_BPP_ADMIN_URL=http://localhost:3001
VITE_BAP_URL=http://localhost:3000

# =============================================================================
# ZITADEL (seller login/registration) — consumed by: zitadel, landing-page
# (ZITADEL_CLIENT_ID), bap-application (buyer auth, best-effort),
# bpp-application/bpp-frontend (seller auth) — see docker-compose.yml's
# zitadel service.
# =============================================================================
# ZITADEL_MASTERKEY must be EXACTLY 32 characters (generate one with:
# openssl rand -base64 24 | cut -c1-32). ZITADEL_ADMIN_* create a human
# console login at localhost:8090/ui/console for debugging only -- no app
# code uses it. ZITADEL_CLIENT_ID is NOT something you fill in -- leave it
# as-is; ./scripts/setup-zitadel.sh writes the real value here
# automatically after creating the OIDC application via Zitadel's API.
ZITADEL_MASTERKEY=REPLACE_WITH_A_32_CHARACTER_SECRET
ZITADEL_ADMIN_USERNAME=admin
ZITADEL_ADMIN_EMAIL=admin@reference-app.local
ZITADEL_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
ZITADEL_CLIENT_ID=SET_BY_SCRIPTS_SETUP_ZITADEL_SH

# Zitadel SMTP (sends verification / OTP / password-reset emails). Pushed
# into Zitadel by scripts/setup-zitadel.sh (run by `task local:up`) -- re-run
# that script after changing any of these.
# ZITADEL_SMTP_HOST is host:port.
ZITADEL_SMTP_HOST=smtp.mailgun.org:587
ZITADEL_SMTP_USER=REPLACE_WITH_SMTP_USERNAME
ZITADEL_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
ZITADEL_SMTP_TLS=true
ZITADEL_SMTP_FROM=no-reply@ion.id
ZITADEL_SMTP_FROM_NAME=ION Reference App

# =============================================================================
# OBSERVABILITY — consumed by: otel-collector-bap, otel-collector-bpp
# =============================================================================
# Where the companion collectors forward filtered onix telemetry (see
# otel-collector/config.yaml's logs/network|metrics/network|traces/network
# pipelines). netcol.iontest.in is ion-monitor's own staging deployment —
# leave this unset to use it. For local testing against a local ion-monitor
# instead, point this at its OTLP/HTTP port (4320 by default; see
# ion-monitor's deploy/local/infra/.env, OTEL_COLLECTOR_HTTP_HOST_PORT) via
# host.docker.internal, which docker-compose.yml's extra_hosts entry on both
# collector services resolves to this machine regardless of which container
# network ion-monitor happens to be on:
# NETWORK_COLLECTOR_ENDPOINT=http://host.docker.internal:4320
NETWORK_COLLECTOR_ENDPOINT=https://netcol.iontest.in

# Seller payout terms (bpp) written into every settlement's settlementAttributes
# as settlementBasis / settlementWindow -- ONDC-style, pending their addition to
# the ION TradeSettlement schema. Basis: DELIVERY | SHIPMENT | RETURN_WINDOW_EXPIRY;
# window: ISO 8601 duration after that event.
SETTLEMENT_BASIS=DELIVERY
SETTLEMENT_WINDOW=P1D
