# Copy to .env. docker-compose.yml reads every variable below.
#
# Not included: onix's keyManager fields (networkParticipant, keyId,
# signingPrivateKey, signingPublicKey, encrPrivateKey, encrPublicKey) — those
# go directly in config/local-simple-bap.yaml / local-simple-bpp.yaml /
# catalog-publish.yaml (copy from their .example files). BAP_ID/BPP_ID below
# MUST match `networkParticipant` in those files — same registered identity.

# ── Beckn identity — BAP ──
BAP_PRIVATE_KEY=REPLACE_WITH_YOUR_SIGNING_PRIVATE_KEY
BAP_KEY_ID=REPLACE_WITH_YOUR_SUBSCRIBER_ID|REPLACE_WITH_YOUR_KEY_ID|ed25519
BAP_ID=REPLACE_WITH_YOUR_SUBSCRIBER_ID

# ── Beckn identity — BPP ──
BPP_PRIVATE_KEY=REPLACE_WITH_YOUR_SIGNING_PRIVATE_KEY
BPP_KEY_ID=REPLACE_WITH_YOUR_SUBSCRIBER_ID|REPLACE_WITH_YOUR_KEY_ID|ed25519
BPP_ID=REPLACE_WITH_YOUR_SUBSCRIBER_ID

# ── Beckn network (shared by bap and bpp) ──
NETWORK_ID=ion.id/ion-launch
# bap's own direct discover call. onix-bap's router has a separate,
# independent discover target in config/local-simple-routing-BAPCaller.yaml.
CDS_DISCOVER_URL=https://34.47.138.217.sslip.io/beckn/discover

# ── Local Postgres ──
DB_USER=postgres
DB_PASSWORD=postgres
