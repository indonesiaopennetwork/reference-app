# Copy to .env and fill in your own registered signing keys.
#
# This file is the single source for every keyManager field in
# config/local-simple-bap.yaml, config/local-simple-bpp.yaml, and
# config/catalog-publish.yaml — run ./scripts/render-onix-config.sh after
# filling this in to generate them from their .example templates (see
# INFRA_SETUP.md 1b for exactly which field comes from where).
#
# BAP_PRIVATE_KEY/BAP_KEY_ID are read directly by the Go apps
# (bap-application/bpp-application) and must stay in their combined
# "subscriberId|keyId|ed25519" / plain-key-string shapes. The *_ONIX_*
# fields below are only consumed by the onix yaml configs, never by the Go
# apps, and must hold the SAME registered keypair as their *_PRIVATE_KEY/
# *_KEY_ID counterpart: BAP_ONIX_KEY_ID = the keyId segment of BAP_KEY_ID
# (the part between the two "|"s), BAP_ONIX_SIGNING_PRIVATE_KEY =
# BAP_PRIVATE_KEY verbatim. They're separate fields only because the Go
# app and the onix yaml consume the identity in different shapes — same
# rule for bpp. (See terraform/README.md's Gotcha #1 for the full "why.")
#
# NETWORK_ID/BAP_ID/BPP_ID are read directly by docker-compose.yml
# (context.bapId/bppId/networkId on every outbound message). BAP_ID/BPP_ID
# must equal the subscriber-ID segment of BAP_KEY_ID/BPP_KEY_ID (the part
# before the first "|") -- same one-identity-per-side rule as above.

NETWORK_ID=REPLACE_WITH_YOUR_NETWORK_ID

BAP_PRIVATE_KEY=REPLACE_WITH_YOUR_SIGNING_PRIVATE_KEY
BAP_KEY_ID=REPLACE_WITH_YOUR_SUBSCRIBER_ID|REPLACE_WITH_YOUR_KEY_ID|ed25519
BAP_ID=REPLACE_WITH_YOUR_BAP_SUBSCRIBER_ID
BAP_ONIX_KEY_ID=REPLACE_WITH_YOUR_BAP_KEY_ID
BAP_ONIX_SIGNING_PRIVATE_KEY=REPLACE_WITH_YOUR_BAP_SIGNING_PRIVATE_KEY
BAP_ONIX_SIGNING_PUBLIC_KEY=REPLACE_WITH_YOUR_BAP_SIGNING_PUBLIC_KEY
BAP_ONIX_ENCR_PRIVATE_KEY=REPLACE_WITH_YOUR_BAP_ENCR_PRIVATE_KEY
BAP_ONIX_ENCR_PUBLIC_KEY=REPLACE_WITH_YOUR_BAP_ENCR_PUBLIC_KEY

BPP_PRIVATE_KEY=REPLACE_WITH_YOUR_SIGNING_PRIVATE_KEY
BPP_KEY_ID=REPLACE_WITH_YOUR_SUBSCRIBER_ID|REPLACE_WITH_YOUR_KEY_ID|ed25519
BPP_ID=REPLACE_WITH_YOUR_BPP_SUBSCRIBER_ID
BPP_ONIX_KEY_ID=REPLACE_WITH_YOUR_BPP_KEY_ID
BPP_ONIX_SIGNING_PRIVATE_KEY=REPLACE_WITH_YOUR_BPP_SIGNING_PRIVATE_KEY
BPP_ONIX_SIGNING_PUBLIC_KEY=REPLACE_WITH_YOUR_BPP_SIGNING_PUBLIC_KEY
BPP_ONIX_ENCR_PRIVATE_KEY=REPLACE_WITH_YOUR_BPP_ENCR_PRIVATE_KEY
BPP_ONIX_ENCR_PUBLIC_KEY=REPLACE_WITH_YOUR_BPP_ENCR_PUBLIC_KEY

# bap's own direct discover call. onix-bap's router has a separate,
# independent discover target in config/local-simple-routing-BAPCaller.yaml.
CDS_DISCOVER_URL=REPLACE_WITH_YOUR_DISCOVER_URL

# ── Local Postgres ──
DB_USER=postgres
DB_PASSWORD=postgres

# Frontend URLs for cross-navigation
VITE_BPP_ADMIN_URL=http://localhost:3001
VITE_BAP_URL=http://localhost:3000

# Zitadel (seller login/registration) -- see docker-compose.yml's zitadel
# service. ZITADEL_MASTERKEY must be EXACTLY 32 characters (generate one
# with: openssl rand -base64 24 | cut -c1-32). ZITADEL_ADMIN_* create a
# human console login at localhost:8090/ui/console for debugging only --
# no app code uses it. ZITADEL_CLIENT_ID is NOT something you fill in --
# leave it as-is; ./scripts/setup-zitadel.sh writes the real value here
# automatically after creating the OIDC application via Zitadel's API.
ZITADEL_MASTERKEY=REPLACE_WITH_A_32_CHARACTER_SECRET
ZITADEL_ADMIN_USERNAME=admin
ZITADEL_ADMIN_EMAIL=admin@reference-app.local
ZITADEL_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
ZITADEL_CLIENT_ID=SET_BY_SCRIPTS_SETUP_ZITADEL_SH
