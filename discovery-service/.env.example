# Copy this file to .env and adjust for your machine:
#   cp .env.example .env
#
# docker-compose reads .env automatically for variable substitution in
# docker-compose.yml. The Go service itself reads the same variable names
# directly via internal/config (see cmd/discovery/main.go). Every
# configurable value the service has lives here — see CONTEXT.md D7.

# Port the discovery-service HTTP server listens on inside the
# container/process.
PORT=8080

# Host port docker-compose maps to the container's PORT. Change this if
# it collides with something else already running on your machine
# (see CONTEXT.md M1 note — 8080 was taken on the original dev machine,
# hence the non-default 8090 here).
HOST_PORT=8090

# HTTP client timeout (seconds) for the client used to deliver on_discover
# callbacks to a BAP's callback URL.
DISPATCH_CLIENT_TIMEOUT_SECONDS=10

# Per-delivery context deadline (seconds) for a single on_discover
# callback attempt.
DISPATCH_DELIVERY_TIMEOUT_SECONDS=10

# --- Background dispatch pool (internal/worker) — see CONTEXT.md D9 ---

# Number of goroutines delivering on_discover callbacks concurrently.
WORKER_POOL_SIZE=10

# How many pending on_discover deliveries may queue for a free worker
# before new ones are dropped (with a logged warning).
WORKER_QUEUE_SIZE=100

# --- HTTP server hardening — see CONTEXT.md D9 ---

# Maximum size (bytes) of a single /discover request body.
MAX_REQUEST_BODY_BYTES=1048576

# Time allowed to read request headers before the connection is dropped.
HTTP_READ_HEADER_TIMEOUT_SECONDS=5

# Time allowed to read the full request (headers + body).
HTTP_READ_TIMEOUT_SECONDS=10

# Time allowed to write the response.
HTTP_WRITE_TIMEOUT_SECONDS=10

# How long an idle keep-alive connection is kept open.
HTTP_IDLE_TIMEOUT_SECONDS=60

# How long graceful shutdown waits for in-flight HTTP requests and queued
# on_discover dispatch jobs to drain before giving up.
SHUTDOWN_TIMEOUT_SECONDS=15

# Docker's own grace period before it SIGKILLs the container on
# `docker compose stop/down`. This is a Compose/Docker-only setting — the
# Go binary never reads it — so keep it a few seconds ABOVE
# SHUTDOWN_TIMEOUT_SECONDS above, or our own graceful shutdown gets cut
# off by Docker before it finishes draining.
STOP_GRACE_PERIOD=20s

# --- Logging (logharbour, github.com/remiges-tech/logharbour) — CONTEXT.md D10 ---

# Minimum log priority to emit. Every HTTP hit (method/path/status/
# duration) is logged at Info regardless of this setting — LOG_LEVEL
# controls verbosity ABOVE that, and setting it to a debug tier
# (debug/debug0/debug1/debug2) additionally dumps the full parsed
# /discover request body for every hit.
# One of: debug2, debug1, debug0 (or "debug"), info, warn, err (or
# "error"), crit, sec. Default: info.
LOG_LEVEL=info

# --- Service identity — CONTEXT.md D13/D20/D21/D22 ---
# This service's OWN, INDEPENDENT registered Beckn subscriber id/URI —
# deliberately NOT the reference app's BAP_ID/BPP_ID, and never sourced
# from them. Discovery Service is architecturally its own network
# participant (it can aggregate catalogs from many Provider Platforms,
# not just this repo's own bpp), so it needs its own identity, not one
# borrowed from a participant it happens to be deployed alongside — and
# these vars are named SUBSCRIBER_*, not BPP_*, precisely so they don't
# suggest otherwise (see D22). Stamped onto the on_discover response
# context (and any catalog entry that doesn't already declare its own
# bppId/bppUri) whenever an incoming /discover request doesn't already
# address a specific BPP — which is the common case for a network-wide
# discovery service; that response FIELD is legitimately named bppId/
# bppUri per the Beckn v2 schema, it's only this config-level identity
# that must never be confused with "the reference app's BPP". Leave blank
# until this service has its own dedicated Ed25519 keypair (whether or
# not it's registered on a network yet — see the signing section below).
SUBSCRIBER_ID=
SUBSCRIBER_URI=

# Alternative to SUBSCRIBER_ID+SIGNING_KEY_ID below: this service's OWN
# identity as a single combined "{subscriberId}|{uniqueKeyId}|{algorithm}"
# string — the same shape this repo's other Go apps use for
# BAP_KEY_ID/BPP_KEY_ID, for consistency, but a wholly separate value
# generated for this service alone, never copied from either of theirs.
# When set, this overrides SUBSCRIBER_ID and SIGNING_KEY_ID (splitting
# it). Leave blank to keep using SUBSCRIBER_ID/SIGNING_KEY_ID directly.
SUBSCRIBER_KEY_ID=

# Path appended to a BAP's context.bapUri to form the on_discover
# callback URL. Per spec, bapUri should already be the BAP's full
# registered subscriber base URL, so the default "/on_discover" is
# correct. Override this ONLY if a specific counterpart's registered
# bapUri is missing its actual receiver route prefix (observed with an
# ONIX bapTxnReceiver expecting "/bap/receiver/on_discover" — a
# registration problem on their side, not something to "fix" by guessing
# in code). This is a stopgap; see CONTEXT.md D14.
ON_DISCOVER_PATH=/on_discover

# --- Outbound request signing (Ed25519) — CONTEXT.md D15/D21 ---
# Real BAPs reject callbacks with no Authorization header
# (AUT_SIGNATURE_MISSING) — this signs outbound on_discover requests per
# beckn.yaml's Signature format. Only active when SUBSCRIBER_ID above is
# set (signing without an identity is meaningless).
#
# SIGNING_PRIVATE_KEY_BASE64: base64-encoded 32-byte Ed25519 seed,
# generated ONCE for this service alone (e.g. `openssl rand -base64 32`)
# — deliberately NOT root .env's BAP_PRIVATE_KEY/BPP_PRIVATE_KEY. Sharing
# another participant's private key would let this service sign AS that
# participant, not just as itself — see CONTEXT.md D21 for why an earlier
# version of this did exactly that, and why it was reverted. Leave blank
# to generate a fresh EPHEMERAL key every process start instead — this
# stops a receiver rejecting a *missing* signature, but nobody can
# actually verify it (nothing has this key registered).
SIGNING_PRIVATE_KEY_BASE64=

# The "{uniqueKeyId}" segment of the signature's keyId — must match
# whatever key id your public key is registered under. Ignored (derived
# instead) when SUBSCRIBER_KEY_ID above is set.
SIGNING_KEY_ID=key-1

# How long a signature is valid for (created -> expires), in seconds.
SIGNING_VALIDITY_SECONDS=300

# --- Inbound request verification (Ed25519) — CONTEXT.md D15/M4/D22 ---
# Verifies the Authorization header on incoming /discover requests against
# a single trusted caller instead of accepting anything — see
# internal/signing.Verifier and internal/handlers.VerifyMiddleware. Named
# TRUSTED_CALLER_*, not CALLER_BAP_*: which participant is actually
# trusted here (in this reference deployment, our own BAP, since its onix
# bapTxnCaller is what signs the outbound /discover request) is this
# deployment's choice, not something Discovery Service should assume by
# role name — a real Discovery Service in a live network could equally be
# called by any authorized participant. Both vars below must be set for
# verification to run; leaving either blank disables it (every request is
# accepted unchecked, logged as a warning) so the service still runs
# zero-configured, matching this repo's other "fail-open with a warning"
# auth stopgaps.
#
# TRUSTED_CALLER_KEY_ID: the trusted caller's combined
# "{subscriberId}|{uniqueKeyId}|{algorithm}" identity — safe to reuse root
# .env's BAP_KEY_ID directly, since it's just a public identifier, not a
# secret.
TRUSTED_CALLER_KEY_ID=

# The trusted caller's base64-encoded 32-byte Ed25519 PUBLIC key ONLY —
# reuse root .env's BAP_ONIX_SIGNING_PUBLIC_KEY (a public key is safe to
# share; a private key is not). NEVER put BAP_PRIVATE_KEY here: this
# service only ever needs to verify as the trusted caller, never sign as
# it, so it must never be given a credential capable of doing that — see
# CONTEXT.md D21 for why an earlier version of this wrongly used the
# private key (to derive the public key locally) and why that was
# reverted.
TRUSTED_CALLER_PUBLIC_KEY_BASE64=

# --- Real catalog sources (internal/dedicrawl) — CONTEXT.md D19 ---
# Comma-separated Provider Node catalog index URLs to crawl for real
# catalog data, e.g.
# "https://bpp.example.com/index/becknCatalogs.index.json" — the real,
# spec-shaped index/baseline/change-file documents (plain or
# gzip-compressed), digest-verified but NOT signature-verified (see
# CONTEXT.md D19 for why). Leave blank (the default) to keep serving the
# embedded M1 demo catalog (data/catalog.json) instead.
CATALOG_INDEX_URLS=

# How often each configured index URL is re-crawled in the background
# after the initial fetch at startup.
CATALOG_REFRESH_INTERVAL_SECONDS=60

# Timeout for a single HTTP call (list or detail) to a catalog source.
CATALOG_FETCH_TIMEOUT_SECONDS=10
