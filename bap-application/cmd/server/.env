APP_PORT=8083
APP_ENV=development
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5435
DB_NAME=bap
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# Beckn identity for this BAP.
# BAP_URI goes inside context.bapUri so the adapter/BPP knows where to send callbacks.
BAP_ID=onix-bap-x7m2wmy7nq-et.a.run.app
BAP_URI=http://localhost:8081
NETWORK_ID=ion.id/ion-launch

# BPP identity — placed inside context.bppId / context.bppUri.
BPP_ID=onix-bpp-x7m2wmy7nq-et.a.run.app
BPP_URI=http://localhost:8082

# BAP_CALLER_URL is the ONIX BAP caller the BAP actually POSTs to.
# Action is appended: <BAP_CALLER_URL>/select, /init, /confirm …
BAP_CALLER_URL=http://localhost:8081/bap/caller

# CDS discover endpoint (Beckn v2 GET /discover)
CDS_DISCOVER_URL=
